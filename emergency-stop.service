[Unit]
Description=Emergency Stop — spegne servizi non critici quando il server soffre
After=docker.service
Wants=docker.service

[Service]
Type=oneshot
# Verifica le dipendenze PRIMA di eseguire: senza questo, se requests/yaml
# mancano ogni run fallisce con ModuleNotFoundError e il timer va in errore.
ExecStartPre=/usr/bin/python3 -c "import requests, yaml"
ExecStart=/usr/bin/python3 /mnt/applicazioni/emergency-stop/emergency-stop.py
User=root
WorkingDirectory=/etc/emergency-stop

[Install]
WantedBy=multi-user.target
