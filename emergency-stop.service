[Unit]
Description=Emergency Stop — spegne servizi non critici quando il server soffre
After=docker.service
Wants=docker.service

[Service]
Type=oneshot
# Job one-shot: systemd lancia il container, il timer lo richiama ogni 60s.
ExecStart=/usr/bin/docker start -a emergency-stop
User=root

[Install]
WantedBy=multi-user.target
