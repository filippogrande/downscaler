# Emergency Stop — variabili d'ambiente
#
# SOLO variabili d'ambiente del container.
# La metrica, le soglie e l'elenco servizi stanno in config.yaml (montato nel container
# a /app/config.yaml) e in services/ (montato a /app/services).

# ── DRY-RUN ──────────────────────────────────────────────────────────────────
# true  = mostra cosa farebbe, SENZA spegnere/riaccendere nulla (sicuro)
# false = esegue davvero
#
# Primo avvio: lascia true, verifica con 'docker compose run --rm emergency-stop --dry-run',
# poi passalo a false.
DRY_RUN=true
