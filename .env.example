# Emergency Stop — variabili d'ambiente
#
# Tutti i valori qui sono SOLO variabili d'ambiente del container.
# La soglia, la metrica e l'elenco servizi stanno in config.yaml e in services/.

# ── DRY-RUN ──────────────────────────────────────────────────────────────────
# true  = mostra cosa farebbe, SENZA spegnere/riaccendere nulla (sicuro)
# false = esegue davvero
#
# Primo avvio: lascia true, verifica, poi passalo a false.
DRY_RUN=true

# ── GLANCES ──────────────────────────────────────────────────────────────────
# URL dell'istanza Glances che espone la metrica (iowait o load)
GLANCES_URL=http://10.0.0.5:61208

# ── TELEGRAM ─────────────────────────────────────────────────────────────────
# Notifiche: inizio downscale, servizio fermato, inizio recovery, fine incidente
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── SERVIZI ──────────────────────────────────────────────────────────────────
# La directory con i file <nome>.yaml dei servizi gestibili
SERVICES_DIR=./services
